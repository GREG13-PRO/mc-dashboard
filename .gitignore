node_modules/
dist/
build/
.env
# Everything the running dashboard writes. Listing individual files was fine
# when there were two of them; there are now caches, archives, published
# installers and a GitHub token in here, and the next one added would have been
# committed by whoever ran the backend from a checkout.
backend/data/*
!backend/data/.gitkeep
*.log
.DS_Store

# Local Claude Code settings may contain secrets (SSH hosts, passwords) — never commit
.claude/
desktop/release/
# The app icon has to be tracked: electron-builder reads it from the build
# resources directory, so a CI machine that never gets this file ships
# installers wearing Electron's default icon. Git cannot re-include a file whose
# parent directory is excluded - and `build/` on line 3 excludes this one - so
# the directory is un-ignored first, then its contents, then the one exception.
!desktop/build/
desktop/build/*
!desktop/build/icon.png

# Android build output
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Paper plugin build output
plugin/.gradle/
plugin/build/

# Staged copy of the backend for the desktop installer
desktop/backend-bundle/
